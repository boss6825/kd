# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3006

# ── Database: Neon Postgres ───────────────────────────────────────────────────
# Pooled connection string — used by the app at runtime. In the Neon console,
# copy "Connection string" with the Pooled connection toggle ON (host contains
# "-pooler"). Keep ?sslmode=require.
DATABASE_URL=postgresql://neondb_owner:npg_Ik4SKzV7sgyH@ep-late-cake-ao6i1hgq-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# used for Application runtime (Next.js, Express, APIs, production server) 

# Direct (unpooled) string — used only for migrations (drizzle-kit). Same as
# above but the host WITHOUT "-pooler". Optional; falls back to DATABASE_URL.
DIRECT_URL=postgresql://neondb_owner:npg_Ik4SKzV7sgyH@ep-late-cake-ao6i1hgq.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# -> used for Database migrations, schema pushes, Drizzle Kit, Prisma migrations

# Optional: max pooled connections this server holds (default 10).
# DATABASE_POOL_MAX=10

# ── Better Auth ───────────────────────────────────────────────────────────────
# Random 32+ byte secret.  Generate with:  openssl rand -hex 32
BETTER_AUTH_SECRET=d5f47ff04be68783c183636ab745030a7372f67360254691c59e2dbfa904fb5a
# Public URL of THIS backend (where Better Auth is mounted at /api/auth).
BETTER_AUTH_URL=http://localhost:3001



# ── Email: Resend (password reset / verification) ─────────────────────────────
# Without this, signup/login still work but reset emails are only logged.
RESEND_API_KEY=
# Verified sender. For quick tests Resend allows:  KD <onboarding@resend.dev>
RESEND_FROM=

# ── Storage: Cloudflare R2 (S3-compatible) ────────────────────────────────────
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=KD

# ── LLM provider keys (server-wide fallback; users may also set their own) ────
# Leave blank to use per-user keys in Account > Models & API Keys.
# Placeholder values like "your-openai-key" are ignored.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── App secrets ───────────────────────────────────────────────────────────────
# Required. Encrypts per-user API keys (IndianKanoon / LLM) at rest.
# The backend will not start, and Account key saves will fail, without this.
# Generate with: openssl rand -hex 32
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret
# Signs /download/:token URLs.  openssl rand -hex 32  (use a value distinct from
# BETTER_AUTH_SECRET and USER_API_KEYS_ENCRYPTION_SECRET).
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string

# ── eCourts India partner API ─────────────────────────────────────────────────
# Bearer token, format eci_live_<32 chars>. Used by backend/src/lib/ecourts.ts.
ECOURTS_API_KEY=eci_live_your_token_here

# ── Optional: auth rate limiting overrides ────────────────────────────────────
# RATE_LIMIT_AUTH_WINDOW_MINUTES=15
# RATE_LIMIT_AUTH_MAX=100
